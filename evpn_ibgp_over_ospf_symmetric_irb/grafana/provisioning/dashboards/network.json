          "pluginVersion": "4.13.0",
          "queryType": "table",
          "rawSql": "SELECT\n    remote_bgp_id AS reporting_router,\n    vpn_rd        AS rd,\n    concat(\n        ip_address, '/',\n        toString(ip_len)\n    )                                          AS prefix,\n    argMax(nexthop, kafka_offset)              AS vtep,\n    argMax(vni, kafka_offset)                  AS vni,\n    arrayFirst(\n        x -> startsWith(x, 'rt='),\n        JSONExtract(JSONExtractRaw(argMax(payload, kafka_offset), 'base_attrs'), 'ext_community_list', 'Array(String)')\n    )                                          AS route_target,\n    max(ingested_at)                           AS last_seen\nFROM bmp.gobmp_parsed_evpn\nWHERE route_type = 5\n  AND is_loc_rib = true\n  AND remote_bgp_id IN (${BmpRouter:singlequote})\nGROUP BY\n    reporting_router,\n    rd,\n    prefix\nHAVING argMax(action, kafka_offset) = 'add'\nORDER BY reporting_router, vni, prefix\n",
          "refId": "A"
        }
      ],
